# إعدادات التطبيق العامة (Application Settings)
APP_NAME=Laravel # اسم التطبيق
APP_ENV=local # بيئة تشغيل التطبيق (محلي local، اختبار test، إنتاج production)
APP_KEY= # مفتاح التشفير الفريد للتطبيق (يتم توليده تلقائياً عبر artisan key:generate)
APP_DEBUG=true # تفعيل وضع تنقيح الأخطاء وعرض تفاصيل الخطأ (يجب تعطيله في الإنتاج)
APP_URL=http://localhost # الرابط الأساسي للتطبيق

APP_LOCALE=en # اللغة الافتراضية للتطبيق
APP_FALLBACK_LOCALE=en # لغة الاحتياط في حال عدم توفر الترجمة
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12 # عدد دورات تشفير BCRYPT لكلمات المرور

# إعدادات تسجيل الأحداث (Logging)
LOG_CHANNEL=stack
LOG_LEVEL=debug

# إعدادات الاتصال بقاعدة البيانات (Database Configuration)
DB_CONNECTION=sqlite # نوع محرك قاعدة البيانات (مثال: mysql, sqlite, pgsql)
# DB_HOST=127.0.0.1 # عنوان خادم قاعدة البيانات
# DB_PORT=3306 # منفذ قاعدة البيانات الافتراضي لـ MySQL
# DB_DATABASE=laravel # اسم قاعدة البيانات
# DB_USERNAME=root # اسم مستخدم قاعدة البيانات
# DB_PASSWORD= # كلمة مرور قاعدة البيانات

# إعدادات الجلسات (Sessions)
SESSION_DRIVER=database # مكان حفظ بيانات الجلسات (ملفات، قاعدة بيانات، كاش)
SESSION_LIFETIME=120 # مدة صلاحية الجلسة بالدقائق (ساعتان)

# إعدادات الاتصال بالأنظمة الأخرى والملفات والعمليات المؤجلة
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local # القرص الافتراضي لتخزين الملفات المرفوعة
QUEUE_CONNECTION=database # مشغل الطوابير للعمليات التي تتم في الخلفية (Queue)

# إعدادات الكاش وحفظ البيانات المؤقتة (Caching)
CACHE_STORE=database

# إعدادات خادم البريد الإلكتروني (Mail Configuration)
MAIL_MAILER=log # مشغل البريد (log يقوم بحفظ رسائل البريد في ملف log للتطوير)
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# إعدادات خدمة التخزين السحابي AWS (اختياري)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# متغيرات خاصة بأداة البناء Vite
VITE_APP_NAME="${APP_NAME}"

